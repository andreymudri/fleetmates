{
  "$description": "fleetmates deck design tokens (W3C DTCG format). Single fixed dark theme (Decided). Three tiers: primitive (color.*, crew.slot.*), semantic (bg, text, border, state, tier, brand, focus, overlay, shadow, space, radius, size, font, motion, z, layout), component (component.*). $extensions.deck.status marks each value Decided (from the owner or the canvas), Proposed (handoff recommendation) or Open. $extensions.deck.was records the canvas value a token replaced. tokens.css is generated from this file; see design-system.md section 12.",
  "color": {
    "$description": "Primitive palette. Components never reference these directly; use the semantic tiers. Tokyo Night style hues on blue-black neutrals (Decided, D-37).",
    "ink": {
      "$type": "color",
      "950": { "$value": "#0f1016", "$description": "Deepest neutral: terminals, code, diff, graph canvas", "$extensions": { "deck": { "status": "Decided" } } },
      "900": { "$value": "#15161e", "$description": "Page canvas", "$extensions": { "deck": { "status": "Decided" } } },
      "850": { "$value": "#181922", "$description": "Sidebars and quiet cards", "$extensions": { "deck": { "status": "Decided" } } },
      "800": { "$value": "#1b1c26", "$description": "Cards, drawers, panels", "$extensions": { "deck": { "status": "Decided" } } },
      "700": { "$value": "#22243a", "$description": "Raised: dialogs, chips, selected rows", "$extensions": { "deck": { "status": "Decided" } } },
      "600": { "$value": "#2b2f45", "$description": "Controls, default border, tracks, kbd", "$extensions": { "deck": { "status": "Decided" } } },
      "500": { "$value": "#3a3f5c", "$description": "Strong border (dialogs, ghost buttons)", "$extensions": { "deck": { "status": "Decided" } } },
      "400": { "$value": "#666e94", "$description": "Field border that reaches 3:1 against every surface (WCAG 1.4.11)", "$extensions": { "deck": { "status": "Proposed", "was": "#3a3f5c on inputs (1.76:1)" } } }
    },
    "fog": {
      "$type": "color",
      "500": { "$value": "#8f96b8", "$description": "Muted text. Replaced #6b7294 after a contrast fix", "$extensions": { "deck": { "status": "Decided", "was": "#6b7294, and #737aa2 terminal dim" } } },
      "400": { "$value": "#b4bbdb", "$description": "Secondary text", "$extensions": { "deck": { "status": "Decided" } } },
      "300": { "$value": "#c8d0f0", "$description": "Default text", "$extensions": { "deck": { "status": "Decided" } } },
      "100": { "$value": "#e6e9f7", "$description": "Strong text, commands, focused input", "$extensions": { "deck": { "status": "Decided" } } }
    },
    "teal": {
      "$type": "color",
      "950": { "$value": "#0e2a2b", "$description": "Ink on teal fills", "$extensions": { "deck": { "status": "Decided" } } },
      "900": { "$value": "#16302f", "$description": "Teal tint background", "$extensions": { "deck": { "status": "Decided" } } },
      "850": { "$value": "#1d3a3a", "$description": "Active rail item, disabled primary", "$extensions": { "deck": { "status": "Decided" } } },
      "700": { "$value": "#2f5f5f", "$description": "Teal border", "$extensions": { "deck": { "status": "Decided" } } },
      "600": { "$value": "#35b0b0", "$description": "Primary pressed", "$extensions": { "deck": { "status": "Proposed" } } },
      "500": { "$value": "#3cc8c8", "$description": "Sea teal brand accent", "$extensions": { "deck": { "status": "Decided" } } },
      "400": { "$value": "#59d0d0", "$description": "Primary hover", "$extensions": { "deck": { "status": "Proposed" } } },
      "300": { "$value": "#7fe3e3", "$description": "Links, teal text, focus ring", "$extensions": { "deck": { "status": "Decided" } } },
      "200": { "$value": "#a6f0f0", "$description": "Link hover", "$extensions": { "deck": { "status": "Decided" } } },
      "150": { "$value": "#bdeeee", "$description": "Text on teal tint", "$extensions": { "deck": { "status": "Decided" } } },
      "100": { "$value": "#9fd6d6", "$description": "Text on disabled primary", "$extensions": { "deck": { "status": "Decided" } } }
    },
    "green": {
      "$type": "color",
      "900": { "$value": "#1f2a1c", "$description": "Green tint (safe badge, running pill, diff add, gate info)", "$extensions": { "deck": { "status": "Decided", "was": "#16241a diff add" } } },
      "700": { "$value": "#3f5a2e", "$description": "Green border", "$extensions": { "deck": { "status": "Decided" } } },
      "400": { "$value": "#9ece6a", "$description": "Running, safe, passed", "$extensions": { "deck": { "status": "Decided" } } },
      "200": { "$value": "#b9d98f", "$description": "Text on green tint", "$extensions": { "deck": { "status": "Decided" } } }
    },
    "amber": {
      "$type": "color",
      "900": { "$value": "#2c261c", "$description": "Amber tint (needs you, caution, question, stale pill, connection banner)", "$extensions": { "deck": { "status": "Decided", "was": "#2a2419 banner and adrift pill, #1d1a14 Focus approval bar" } } },
      "800": { "$value": "#3a3120", "$description": "Amber chip on an amber tint (compact action strip)", "$extensions": { "deck": { "status": "Decided" } } },
      "750": { "$value": "#4d3f28", "$description": "Soft amber border (caution card, warn row, stale card)", "$extensions": { "deck": { "status": "Decided", "was": "#4a3f2e" } } },
      "700": { "$value": "#7a6036", "$description": "Amber border (needs-you cards, amber ghost buttons)", "$extensions": { "deck": { "status": "Decided" } } },
      "500": { "$value": "#d6a86a", "$description": "Stale (adrift) foreground, kept distinct from needs-you amber", "$extensions": { "deck": { "status": "Proposed" } } },
      "400": { "$value": "#e0af68", "$description": "Needs you, caution", "$extensions": { "deck": { "status": "Decided" } } },
      "300": { "$value": "#e5bb7f", "$description": "Amber filled hover", "$extensions": { "deck": { "status": "Proposed" } } },
      "250": { "$value": "#c59a5c", "$description": "Amber filled pressed", "$extensions": { "deck": { "status": "Proposed" } } },
      "200": { "$value": "#e8c690", "$description": "Secondary text on amber tint", "$extensions": { "deck": { "status": "Decided" } } },
      "100": { "$value": "#f0dcb4", "$description": "Primary text on amber tint", "$extensions": { "deck": { "status": "Decided" } } }
    },
    "purple": {
      "$type": "color",
      "950": { "$value": "#1d1530", "$description": "Ink on purple fills", "$extensions": { "deck": { "status": "Decided" } } },
      "900": { "$value": "#231f33", "$description": "Purple tint (done, draft, review rows)", "$extensions": { "deck": { "status": "Decided" } } },
      "700": { "$value": "#5b4a86", "$description": "Purple border (done card)", "$extensions": { "deck": { "status": "Decided" } } },
      "400": { "$value": "#bb9af7", "$description": "Done, to review, room speaker", "$extensions": { "deck": { "status": "Decided" } } },
      "300": { "$value": "#c5a9f8", "$description": "Purple filled hover", "$extensions": { "deck": { "status": "Proposed" } } },
      "250": { "$value": "#a588d9", "$description": "Purple filled pressed", "$extensions": { "deck": { "status": "Proposed" } } }
    },
    "red": {
      "$type": "color",
      "950": { "$value": "#2a0f15", "$description": "Ink on red fills", "$extensions": { "deck": { "status": "Decided" } } },
      "900": { "$value": "#2e1c22", "$description": "Red tint (destructive, crashed, recording bar, diff del)", "$extensions": { "deck": { "status": "Decided", "was": "#2a1519 diff del" } } },
      "850": { "$value": "#4a2630", "$description": "Disabled destructive fill", "$extensions": { "deck": { "status": "Decided" } } },
      "700": { "$value": "#6b2d3a", "$description": "Red border", "$extensions": { "deck": { "status": "Decided", "was": "#5a2a35 on danger ghost buttons" } } },
      "400": { "$value": "#f7768e", "$description": "Crashed, destructive, recording, stop", "$extensions": { "deck": { "status": "Decided" } } },
      "300": { "$value": "#f88b9f", "$description": "Red filled hover", "$extensions": { "deck": { "status": "Proposed" } } },
      "250": { "$value": "#d9687d", "$description": "Red filled pressed", "$extensions": { "deck": { "status": "Proposed" } } },
      "200": { "$value": "#f4b3be", "$description": "Text on red tint and error excerpts", "$extensions": { "deck": { "status": "Decided" } } },
      "150": { "$value": "#e7c3ca", "$description": "Secondary text on the recording bar", "$extensions": { "deck": { "status": "Decided" } } },
      "100": { "$value": "#c48d98", "$description": "Text on disabled destructive fill (4.7:1)", "$extensions": { "deck": { "status": "Proposed", "was": "#b77f8a (3.98:1)" } } }
    },
    "blue": {
      "$type": "color",
      "900": { "$value": "#1f2740", "$description": "Blue tint (tag chip)", "$extensions": { "deck": { "status": "Decided" } } },
      "400": { "$value": "#7aa2f7", "$description": "Prompts and edits in logs, nestjs domain", "$extensions": { "deck": { "status": "Decided" } } },
      "300": { "$value": "#9db8f8", "$description": "Text on blue tint", "$extensions": { "deck": { "status": "Decided" } } }
    },
    "cyan": {
      "$type": "color",
      "400": { "$value": "#7dcfff", "$description": "Inline code, docker domain", "$extensions": { "deck": { "status": "Decided" } } }
    },
    "orange": {
      "$type": "color",
      "400": { "$value": "#ff9e64", "$description": "concorrencia domain dot", "$extensions": { "deck": { "status": "Decided" } } }
    },
    "black": { "$type": "color", "$value": "#000000", "$description": "Only for shade mixing and shadows" },
    "white": { "$type": "color", "$value": "#ffffff", "$description": "Only for shade mixing" }
  },
  "crew": {
    "$description": "Pixel crew data tokens. Nine body color slots; a repo gets the first free slot on first sight, saved, never reused (see crew.md). Slot order is the assignment order.",
    "slot": {
      "$type": "color",
      "0": { "$value": "#ff9e64", "$description": "orange (fleetmates)", "$extensions": { "deck": { "status": "Decided" } } },
      "1": { "$value": "#f7768e", "$description": "rose (rustot)", "$extensions": { "deck": { "status": "Decided" } } },
      "2": { "$value": "#7aa2f7", "$description": "blue (vault-mcp)", "$extensions": { "deck": { "status": "Decided" } } },
      "3": { "$value": "#73daca", "$description": "mint (discord-audit)", "$extensions": { "deck": { "status": "Decided" } } },
      "4": { "$value": "#bb9af7", "$description": "lilac (andreymudri.com)", "$extensions": { "deck": { "status": "Decided" } } },
      "5": { "$value": "#7dcfff", "$description": "sky (turbidassist)", "$extensions": { "deck": { "status": "Decided" } } },
      "6": { "$value": "#c3e88d", "$description": "lime (rustot-client)", "$extensions": { "deck": { "status": "Decided" } } },
      "7": { "$value": "#e0c98a", "$description": "sand (axios-like)", "$extensions": { "deck": { "status": "Decided" } } },
      "8": { "$value": "#f5a3d7", "$description": "pink (free on the canvas). Replaces the CrewSheet swatches #ffc777, #b4f9f8, #fca7ea, which were not in any slot list", "$extensions": { "deck": { "status": "Proposed" } } }
    },
    "research": { "$type": "color", "$value": "#c0caf5", "$description": "Research runs and scouts: outside the slot pool so research never consumes a repo slot", "$extensions": { "deck": { "status": "Proposed" } } },
    "ink": { "$type": "color", "$value": "{color.ink.900}", "$description": "Open eyes and smile" },
    "hat": {
      "$type": "color",
      "team": { "$value": "{color.teal.500}", "$description": "Every member of a fleetmates run (and research scouts) wears the teal cap", "$extensions": { "deck": { "status": "Decided" } } }
    },
    "signal": {
      "$type": "color",
      "needs": { "$value": "{color.amber.400}", "$description": "Amber flag pixels on the needs pose" },
      "idle": { "$value": "{color.fog.500}", "$description": "Z pixels on the idle pose" },
      "crashed": { "$value": "{color.red.400}", "$description": "Red eyes on the crashed pose" }
    },
    "shade": {
      "$type": "number",
      "light": { "$value": 0.35, "$description": "mix(body, white, 0.35)" },
      "dark": { "$value": 0.35, "$description": "mix(body, black, 0.35)" }
    },
    "size": {
      "$type": "dimension",
      "sm": { "$value": "27px", "$description": "cell 3: cards, rows, lists (minimum readable size)", "$extensions": { "deck": { "status": "Decided" } } },
      "md": { "$value": "36px", "$description": "cell 4: card and page headers, team tiles", "$extensions": { "deck": { "status": "Decided" } } },
      "lg": { "$value": "45px", "$description": "cell 5: dialogs, FirstRun", "$extensions": { "deck": { "status": "Proposed", "was": "54px FirstRun" } } },
      "xl": { "$value": "72px", "$description": "cell 8: HomeCalm hero, CrewSheet, customize preview", "$extensions": { "deck": { "status": "Proposed", "was": "63px and 108px" } } }
    }
  },
  "bg": {
    "$type": "color",
    "$description": "Surfaces, darkest to lightest. Elevation is expressed by lighter surfaces, shadows only on overlays.",
    "sunken": { "$value": "{color.ink.950}", "$description": "Terminals, code blocks, diff, graph canvas, rail", "$extensions": { "deck": { "status": "Decided", "was": "#111219 rail, #12131a graph" } } },
    "canvas": { "$value": "{color.ink.900}", "$description": "Page background, inner wells inside cards", "$extensions": { "deck": { "status": "Decided", "was": "#131420 compact tail" } } },
    "sidebar": { "$value": "{color.ink.850}", "$description": "Secondary sidebars, quiet cards" },
    "surface": { "$value": "{color.ink.800}", "$description": "Cards, drawers, right panels" },
    "raised": { "$value": "{color.ink.700}", "$description": "Dialogs, palette, chips, selected rows" },
    "control": { "$value": "{color.ink.600}", "$description": "Selected tab or segment, kbd, progress track, user chat bubble" },
    "hover": { "$value": "rgba(200, 208, 240, 0.06)", "$description": "State layer over any surface on hover", "$extensions": { "deck": { "status": "Proposed" } } },
    "press": { "$value": "rgba(200, 208, 240, 0.10)", "$description": "State layer over any surface while pressed", "$extensions": { "deck": { "status": "Proposed" } } },
    "selected": { "$value": "{color.ink.700}", "$description": "Selected list row (with ring.selected)", "$extensions": { "deck": { "status": "Proposed", "was": "#2b2f45 in Palette and Focus list" } } },
    "skeleton": { "$value": "{color.ink.700}", "$description": "Skeleton base", "$extensions": { "deck": { "status": "Proposed", "was": "#1f2130" } } },
    "skeleton-highlight": { "$value": "{color.ink.600}", "$description": "Skeleton shimmer highlight", "$extensions": { "deck": { "status": "Proposed", "was": "#262939" } } },
    "mark": { "$value": "{color.teal.900}", "$description": "Search hit highlight" }
  },
  "text": {
    "$type": "color",
    "strong": { "$value": "{color.fog.100}", "$description": "Commands, focused input, emphasis" },
    "default": { "$value": "{color.fog.300}", "$description": "Body text" },
    "secondary": { "$value": "{color.fog.400}", "$description": "Supporting lines, prose lists" },
    "muted": { "$value": "{color.fog.500}", "$description": "Meta, subtitles, eyebrows, terminal dim lines" },
    "link": { "$value": "{color.teal.300}", "$description": "Links and teal emphasis" },
    "link-hover": { "$value": "{color.teal.200}" },
    "on-primary": { "$value": "{color.teal.950}" },
    "on-primary-disabled": { "$value": "{color.teal.100}" },
    "on-amber": { "$value": "{color.ink.900}" },
    "on-danger": { "$value": "{color.red.950}" },
    "on-danger-disabled": { "$value": "{color.red.100}" },
    "on-purple": { "$value": "{color.purple.950}" },
    "on-teal-tint": { "$value": "{color.teal.150}" },
    "on-amber-tint": { "$value": "{color.amber.100}" },
    "on-amber-tint-secondary": { "$value": "{color.amber.200}" },
    "on-green-tint": { "$value": "{color.green.200}" },
    "on-red-tint": { "$value": "{color.red.200}" },
    "on-red-tint-secondary": { "$value": "{color.red.150}", "$extensions": { "deck": { "status": "Proposed", "was": "#b98f98 (5.7:1) also used on the recording bar" } } },
    "on-blue-tint": { "$value": "{color.blue.300}" },
    "code": { "$value": "{color.cyan.400}", "$description": "Inline code in prose and answers" },
    "diff-add": { "$value": "{color.green.400}" },
    "diff-del": { "$value": "{color.red.400}" }
  },
  "border": {
    "$type": "color",
    "subtle": { "$value": "{color.ink.700}", "$description": "Table row rules" },
    "default": { "$value": "{color.ink.600}", "$description": "Cards, dividers, ghost buttons on surfaces" },
    "strong": { "$value": "{color.ink.500}", "$description": "Dialogs, drawers, neutral ghost buttons" },
    "field": { "$value": "{color.ink.400}", "$description": "Text inputs, selects, textareas (3:1 boundary)", "$extensions": { "deck": { "status": "Proposed", "was": "#2b2f45 / #3a3f5c" } } },
    "field-focus": { "$value": "{color.teal.500}", "$description": "Focused field border (2px)" }
  },
  "brand": {
    "$type": "color",
    "accent": { "$value": "{color.teal.500}", "$description": "Sea teal: primary actions, logo, cited, active", "$extensions": { "deck": { "status": "Decided" } } },
    "accent-hover": { "$value": "{color.teal.400}" },
    "accent-press": { "$value": "{color.teal.600}" },
    "accent-tint": { "$value": "{color.teal.900}" },
    "accent-border": { "$value": "{color.teal.700}" },
    "accent-strong-tint": { "$value": "{color.teal.850}", "$description": "Active rail item" }
  },
  "focus": {
    "ring": { "$type": "color", "$value": "{color.teal.300}", "$description": "Focus-visible outline color, 8:1 or better on every surface", "$extensions": { "deck": { "status": "Proposed" } } },
    "ring-width": { "$type": "dimension", "$value": "2px" },
    "ring-offset": { "$type": "dimension", "$value": "2px", "$description": "Outline offset. Inside clipped containers (list rows, terminal) use -2px (inset)" }
  },
  "state": {
    "$description": "One entry per SessionState (02-domain.md section 3). fg is pill text, icon and dot; bg is the pill fill; border is the card border. Pill labels are literal (Decided).",
    "starting": {
      "fg": { "$type": "color", "$value": "{color.green.400}" },
      "bg": { "$type": "color", "$value": "{color.green.900}" },
      "border": { "$type": "color", "$value": "{color.ink.600}" },
      "$extensions": { "deck": { "status": "Proposed", "label": "Starting", "icon": "loader-circle", "pose": "running" } }
    },
    "running": {
      "fg": { "$type": "color", "$value": "{color.green.400}" },
      "bg": { "$type": "color", "$value": "{color.green.900}", "$extensions": { "deck": { "status": "Proposed", "was": "#1e2433 (blue-grey, not a green tint)" } } },
      "border": { "$type": "color", "$value": "{color.ink.600}" },
      "$extensions": { "deck": { "status": "Decided", "label": "Running", "icon": "live-dot (compass for research)", "pose": "running" } }
    },
    "needs-approval": {
      "fg": { "$type": "color", "$value": "{color.amber.400}" },
      "bg": { "$type": "color", "$value": "{color.amber.900}" },
      "border": { "$type": "color", "$value": "{color.amber.700}" },
      "$extensions": { "deck": { "status": "Decided", "label": "Needs approval", "icon": "bell", "pose": "needs" } }
    },
    "asked-you": {
      "fg": { "$type": "color", "$value": "{color.amber.400}" },
      "bg": { "$type": "color", "$value": "{color.amber.900}" },
      "border": { "$type": "color", "$value": "{color.amber.700}" },
      "$extensions": { "deck": { "status": "Decided", "label": "Asked you", "icon": "bell", "pose": "needs" } }
    },
    "done": {
      "fg": { "$type": "color", "$value": "{color.purple.400}" },
      "bg": { "$type": "color", "$value": "{color.purple.900}" },
      "border": { "$type": "color", "$value": "{color.purple.700}" },
      "$extensions": { "deck": { "status": "Decided", "label": "Done", "icon": "check", "pose": "done" } }
    },
    "stale": {
      "fg": { "$type": "color", "$value": "{color.amber.500}" },
      "bg": { "$type": "color", "$value": "{color.amber.900}", "$extensions": { "deck": { "was": "#2a2419" } } },
      "border": { "$type": "color", "$value": "{color.amber.750}", "$extensions": { "deck": { "was": "#4a3f2e" } } },
      "$extensions": { "deck": { "status": "Decided", "label": "No activity {n}m", "icon": "waves", "pose": "idle" } }
    },
    "idle": {
      "fg": { "$type": "color", "$value": "{color.fog.500}" },
      "bg": { "$type": "color", "$value": "{color.ink.700}" },
      "border": { "$type": "color", "$value": "{color.ink.600}" },
      "$extensions": { "deck": { "status": "Decided", "label": "Idle {duration}", "icon": "moon", "pose": "idle" } }
    },
    "reviewed": {
      "fg": { "$type": "color", "$value": "{color.purple.400}" },
      "bg": { "$type": "color", "$value": "{color.purple.900}" },
      "border": { "$type": "color", "$value": "{color.ink.600}" },
      "$extensions": { "deck": { "status": "Decided", "label": "Reviewed", "icon": "check-check", "pose": "done" } }
    },
    "crashed": {
      "fg": { "$type": "color", "$value": "{color.red.400}" },
      "bg": { "$type": "color", "$value": "{color.red.900}" },
      "border": { "$type": "color", "$value": "{color.red.700}" },
      "$extensions": { "deck": { "status": "Decided", "label": "Crashed · exit {code}", "icon": "x", "pose": "crashed" } }
    },
    "ended": {
      "fg": { "$type": "color", "$value": "{color.fog.500}" },
      "bg": { "$type": "color", "$value": "{color.ink.700}" },
      "border": { "$type": "color", "$value": "{color.ink.600}" },
      "$extensions": { "deck": { "status": "Proposed", "label": "Ended", "icon": "square", "pose": "none" } }
    },
    "draft": {
      "fg": { "$type": "color", "$value": "{color.purple.400}" },
      "bg": { "$type": "color", "$value": "{color.purple.900}" },
      "border": { "$type": "color", "$value": "{color.purple.700}" },
      "$extensions": { "deck": { "status": "Decided", "label": "Draft · not saved", "icon": "file-pen", "note": "Research draft, not a SessionState" } }
    }
  },
  "tier": {
    "$description": "Risk tiers for permission requests (07-approvals.md). Question is not a tier but shares the badge.",
    "safe": {
      "fg": { "$type": "color", "$value": "{color.green.400}" },
      "bg": { "$type": "color", "$value": "{color.green.900}" },
