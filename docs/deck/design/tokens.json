      "error": { "$type": "color", "$value": "{color.red.400}" },
      "stale": { "$type": "color", "$value": "{color.amber.500}" },
      "reviewed": { "$type": "color", "$value": "{color.purple.400}" }
    },
    "graph": {
      "edge": { "$type": "color", "$value": "#353a55", "$description": "Unlit edge (kept distinct from border.strong for the graph only)" },
      "edge-lit": { "$type": "color", "$value": "{color.teal.500}" },
      "label-new": { "$type": "color", "$value": "{text.strong}" },
      "arrive-ring": { "$type": "color", "$value": "rgba(230, 233, 247, 0.35)" }
    }
  }
}
